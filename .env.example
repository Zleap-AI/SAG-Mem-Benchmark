# Copy to the repository root .env. Never commit the filled file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
SEARCH_LLM_API_KEY=${OPENAI_API_KEY}
SEARCH_LLM_BASE_URL=${OPENAI_BASE_URL}
SEARCH_LLM_MODEL=qwen/qwen3.6-35b-a3b
JUDGE_LLM_API_KEY=${OPENAI_API_KEY}
JUDGE_LLM_BASE_URL=${OPENAI_BASE_URL}
JUDGE_LLM_MODEL=qwen/qwen3.6-35b-a3b
OPENAI_EXTRA_BODY='{"reasoning":{"enabled":false},"provider":{"only":["DeepInfra"],"allow_fallbacks":false,"quantizations":["fp8"]}}'
JEV_API_KEY=${OPENAI_API_KEY}
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14-20261014
